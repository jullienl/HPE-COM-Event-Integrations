# COM event bridge configuration
# Copy to .env and fill in real values. Never commit the real .env.

# --- COM authentication (same handshake + secret as the relay) ------------

# Secret COM must present on every event (long + random: openssl rand -hex 32)
COM_SHARED_SECRET=change-me
# Header carrying the secret (must match the header set on the COM webhook)
SHARED_SECRET_HEADER=x-shim-secret
# Max accepted request body (bytes). Default 262144 (256 KB).
MAX_BODY_BYTES=262144

# --- Delivery mode --------------------------------------------------------

# sync  : forward inline; a target failure returns 503 so COM retries.
# spool : persist locally, ack COM immediately, background worker drains+retries.
DELIVERY_MODE=sync

# Spool tuning (DELIVERY_MODE=spool only)
SPOOL_PATH=./spool.db
SPOOL_MAX_BYTES=52428800        # 50 MB backlog cap; over this -> 503 (COM retries)
SPOOL_RETRY_SECONDS=30          # base retry delay (exponential backoff)
SPOOL_RETRY_CAP=3600            # max retry delay
SPOOL_POLL_SECONDS=2            # how often the worker checks for due events

# --- Target selection -----------------------------------------------------

# Which target adapter to run: obm | servicenow | opsramp | halo | splunk | webhook
TARGET=obm
# Per-target HTTP timeout (seconds)
TARGET_TIMEOUT=15

# --- De-duplication -------------------------------------------------------

DEDUP_DB_PATH=./dedup.db
DEDUP_TTL_SECONDS=3600

# --- Target: OBM (TARGET=obm) ---------------------------------------------

OBM_EVENT_API_URL=https://obm.example.com/opr-web/rest/9.10/event_list
OBM_USER=change-me
OBM_PASSWORD=change-me

# --- Target: ServiceNow (TARGET=servicenow) -------------------------------

# SNOW_INSTANCE=https://acme.service-now.com
# SNOW_TABLE=em_event            # or 'incident'
# SNOW_USER=change-me
# SNOW_PASSWORD=change-me
# SNOW_RESOLVED_STATE=6          # incident state used to close on a COM 'clear' (default 6 = Resolved)

# --- Target: OpsRamp (TARGET=opsramp) -------------------------------------
# Decoupled path only; for COM-driven use prefer OpsRamp's native integration.

# OPSRAMP_API_URL=https://acme.api.opsramp.com
# OPSRAMP_TENANT_ID=client_1234
# OPSRAMP_KEY=change-me           # OAuth2 key (client_id) of an Integration credential
# OPSRAMP_SECRET=change-me        # OAuth2 secret (client_secret)
# OPSRAMP_SERVICE_NAME=HPE COM

# --- Target: HaloITSM (TARGET=halo) ---------------------------------------
# Pipeline de-dup avoids duplicate tickets for the same fault.

# HALO_API_URL=https://acme.haloitsm.com
# HALO_CLIENT_ID=change-me        # OAuth2 client id (Integration API application)
# HALO_CLIENT_SECRET=change-me    # OAuth2 client secret
# HALO_TENANT=                    # optional (hosted multi-tenant Halo only)
# HALO_TICKET_TYPE_ID=1
# HALO_CLOSED_STATUS_ID=9         # status id set on a ticket when COM reports recovery (instance-specific)

# --- Target: Splunk HEC (TARGET=splunk) -----------------------------------

# SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
# SPLUNK_HEC_TOKEN=change-me
# SPLUNK_SOURCE=hpe-com
# SPLUNK_SOURCETYPE=com:event
# SPLUNK_INDEX=main
# SPLUNK_VERIFY_TLS=true

# --- Target: generic webhook (TARGET=webhook) -----------------------------

# WEBHOOK_URL=https://example.com/inbound
# WEBHOOK_AUTH_HEADER=Authorization
# WEBHOOK_AUTH_VALUE=Bearer change-me
