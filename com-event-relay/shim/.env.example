# COM event shim configuration
# Copy to .env and fill in real values. Never commit the real .env.
#
# SECRETS — file vs env. Sensitive values (target passwords / client secrets /
# tokens, SERVICE_BUS_CONNECTION) can be provided EITHER as the plain variable
# shown here (fine for local dev) OR — preferred in production — as a file, by
# setting "<NAME>_FILE" to a path the app reads at startup (the file wins if both
# are set). Any vault that projects a secret onto disk works (Key Vault / Secrets
# Manager via the Secrets Store CSI driver, Docker secrets at /run/secrets/<name>,
# systemd LoadCredential). Example:
#   SPLUNK_HEC_TOKEN_FILE=/mnt/secrets-store/splunk-hec-token
# See com-event-relay/README.md "Secrets management" for step-by-step wiring.

# --- Target selection -----------------------------------------------------

# Which target adapter(s) to run:
#   obm | servicenow | opsramp | halo | splunk | github | slack | teams |
#   jira | pagerduty | sentinel | datadog | elastic | bmc_helix | dynatrace |
#   grafana | webhook
# One name, or several comma-separated to fan one COM event out to each target.
# Example: open a Halo ticket AND post to Slack from the same event.
#   TARGETS=halo,slack
TARGETS=obm

# Shared: per-target HTTP timeout (seconds)
TARGET_TIMEOUT=15

# --- Server monitored conditions ------------------------------------------
# A COM `.../server` webhook is a full-state snapshot. Choose which server
# aspects open/close an item, comma-separated (default: health):
#   health       hardware health leaves OK        (raise) / returns to OK (clear)
#   power        server powered OFF               (raise) / powered ON     (clear)
#   connection   disconnected from COM            (raise) / reconnected    (clear)
#   subscription not SUBSCRIBED or expired        (raise) / active         (clear)
# Each condition is tracked independently (own correlation key), so e.g. a
# reconnect never closes a "powered off" issue. Enable several to fan out:
#   SERVER_MONITORS=health,power,connection
SERVER_MONITORS=health

# --- AI analysis enrichment (optional; OFF by default) ---------------------
# Runs BETWEEN normalise and delivery, so the analysis lands inside the ticket
# at creation instead of arriving separately. Unset = no enrichment, which is
# the default for every existing deployment.
#
# It is an ENRICHER, not a TARGET: putting it in TARGETS would run it *beside*
# the ticket adapter rather than *before* it, and the ticket would carry no
# analysis.
#
# Only runs on-prem (shim/bridge) — it needs a route to the iLO. It opens an
# extra OUTBOUND connection to the management network; no inbound port.
# ENRICHERS=ilo_ai

# Analyzer service (a separate on-prem container, e.g. the AI Gateway:
# https://github.com/jullienl/ai-gateway). Keeping it separate is what lets the
# model be hosted OR self-hosted without touching the shim. Required when
# ENRICHERS=ilo_ai.
# AI_ANALYZER_URL=http://ai-gateway
# AI_AGENT=com-rca
# AI_TENANT=
# AI_ANALYZER_TOKEN=            # or AI_ANALYZER_TOKEN_FILE (secret)
# AI_TIMEOUT=90

# Gate: only raises at/above this severity are analysed (clears never are).
# normal < warning < minor < major < critical
# AI_MIN_SEVERITY=warning

# Cost ceiling. On breach a circuit breaker trips and events are delivered
# unenriched (logged loudly) rather than spending without limit.
# AI_MAX_ANALYSES_PER_HOUR=60
# AI_MAX_ANALYSES_PER_DAY=500
# Re-use one analysis per problem for this long (0 disables the cache). Stops a
# multi-target retry from re-running — and re-paying for — the same analysis.
# AI_CACHE_TTL_SECONDS=3600
# Alert-sourced events carry no BMC address; this caches the COM API lookup
# used to resolve one (device -> server -> hardware.bmc.ip), per device id.
# ILO_ALERT_MGMT_URL_CACHE_TTL_SECONDS=86400

# iLO / Redfish access for the evidence bundle. Use a dedicated READ-ONLY
# Redfish account: the collector only issues GETs, and this credential is
# typically the same on every iLO in the fleet.
# ILO_USERNAME=com-readonly
# ILO_PASSWORD=                 # prefer ILO_PASSWORD_FILE (secret)
# iLOs ship self-signed certs, so TLS trust needs an explicit decision.
# Point ILO_CA_BUNDLE at the CA that ISSUED the iLO's certificate. Note that the
# iLO's own self-signed cert works here only if it carries basicConstraints
# CA:TRUE -- OpenSSL rejects a plain leaf cert as a trust anchor with "invalid CA
# certificate". If it is a plain leaf, either install a CA-issued cert on the iLO
# or accept ILO_INSECURE=1, which disables verification and exposes the fleet
# credential to interception on the management LAN.

# To skip TLS certificate verification when connecting to the iLO:
# ILO_INSECURE=1
# For production, use a CA-signed cert in iLO and use ILO_CA_BUNDLE:
# ILO_CA_BUNDLE=/etc/ssl/certs/ilo-ca.pem
# ILO_INSECURE=0

# ILO_TIMEOUT=10
# Bound the evidence: an unbounded IML (hundreds of entries, ~240 KB) truncates
# in transit and blows the model's context window.
# ILO_MAX_LOG_ENTRIES=25
# ILO_MAX_MEMBERS=64
# ILO_EXTRA_PATHS=

# --- HPE Customer Advisory enrichment (optional; OFF by default) -----------
# A second, independent enricher: attaches Open/Resolved Customer Advisories
# from the server's installed firmware bundle. Combine it with ilo_ai so its
# evidence is included in the analyzer payload — run order (hpe_advisories
# before ilo_ai) is guaranteed by the framework regardless of how you list
# them here, so ENRICHERS=ilo_ai,hpe_advisories works identically:
# ENRICHERS=hpe_advisories,ilo_ai

# COM API access (read-only: GET /servers/{id} and GET /firmware-bundles/{id}).
# COM_BASE_URL is region/environment specific — see your GreenLake workspace's
# API reference, e.g. https://eu-central.api.greenlake.hpe.com.
# COM_BASE_URL=
# Preferred: client credentials (a GreenLake service client), auto-refreshed —
# a static PAT (below) expires in ~2h with no refresh of its own, so it only
# suits a short manual test.
# COM_CLIENT_ID=
# COM_CLIENT_SECRET=            # prefer COM_CLIENT_SECRET_FILE (secret)
# COM_SSO_TOKEN_URL=https://sso.common.cloud.hpe.com/as/token.oauth2
# COM_PAT=                      # static PAT fallback; prefer COM_PAT_FILE (secret)
# COM_TENANT_ACID=              # MSP tenant selector, if applicable
# COM_TIMEOUT=15

# Gate + cache, same reasoning as ilo_ai's: advisories change rarely and many
# servers share one firmware bundle, so cache by bundle reference, not per event.
# HPE_ADVISORIES_MIN_SEVERITY=warning
# HPE_ADVISORIES_CACHE_TTL_SECONDS=86400
# HPE_ADVISORIES_TIMEOUT=20
# A bundle reference alone isn't proof it's applied (a COM group can assign a
# different/newer baseline than what a device last had directly updated to).
# Also resolves the device's group firmware-compliance record; costs an extra
# GET /groups scan per un-cached device. Set false to skip it.
# HPE_ADVISORIES_CHECK_COMPLIANCE=true

# --- Queue source (must match the relay) ----------------------------------

# servicebus | sqs
QUEUE_BACKEND=servicebus

# Azure Service Bus (QUEUE_BACKEND=servicebus) — use a LISTEN-scoped policy
SERVICE_BUS_CONNECTION=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=listen;SharedAccessKey=change-me
QUEUE_NAME=com-events
RECEIVE_MAX_WAIT=30

# AWS SQS (QUEUE_BACKEND=sqs)
# SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/com-events
# AWS_REGION=eu-west-1

# --- De-duplication -------------------------------------------------------

# Local Python run: ./dedup.db (writable cwd). In the CONTAINER the image already
# defaults this to /data/dedup.db (a writable, non-root-owned dir) — don't set it
# back to ./dedup.db there, as /app is root-owned and the write fails.
DEDUP_DB_PATH=./dedup.db
DEDUP_TTL_SECONDS=3600

# --- Target: OBM (obm) ----------------------------------------------------

OBM_EVENT_API_URL=https://obm.example.com/opr-web/rest/9.10/event_list
OBM_USER=change-me
OBM_PASSWORD=change-me

# --- Target: ServiceNow (servicenow) --------------------------------------

# SNOW_INSTANCE=https://acme.service-now.com
# SNOW_TABLE=em_event            # or 'incident'
# SNOW_USER=change-me
# SNOW_PASSWORD=change-me
# SNOW_RESOLVED_STATE=6          # incident state used to close on a COM 'clear' (default 6 = Resolved)

# --- Target: OpsRamp (opsramp) --------------------------------------------
# Decoupled path only; for COM-driven use prefer OpsRamp's native integration.

# OPSRAMP_API_URL=https://acme.api.opsramp.com
# OPSRAMP_TENANT_ID=client_1234
# OPSRAMP_KEY=change-me           # OAuth2 key (client_id) of an Integration credential
# OPSRAMP_SECRET=change-me        # OAuth2 secret (client_secret)
# OPSRAMP_SERVICE_NAME=HPE COM

# --- Target: HaloITSM (halo) ----------------------------------------------
# Pipeline de-dup avoids duplicate tickets for the same fault.

# HALO_API_URL=https://acme.haloitsm.com
# HALO_CLIENT_ID=change-me        # OAuth2 client id (Integration API application)
# HALO_CLIENT_SECRET=change-me    # OAuth2 client secret
# HALO_TENANT=                    # optional (hosted multi-tenant Halo only)
# HALO_TICKET_TYPE_ID=1
# HALO_CLOSED_STATUS_ID=9         # status id set on a ticket when COM reports recovery (instance-specific)

# --- Target: Splunk HEC (splunk) ------------------------------------------

# SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
# SPLUNK_HEC_TOKEN=change-me
# SPLUNK_SOURCE=hpe-com
# SPLUNK_SOURCETYPE=com:event
# SPLUNK_INDEX=main
# SPLUNK_VERIFY_TLS=true

# --- Target: GitHub Issues (github) ---------------------------------------
# Opens an issue on a raise, closes the matching one on a clear (correlated by a
# com:<key> label + hidden body marker — no external state).

# GITHUB_REPO=owner/repo         # repo the issues live in, e.g. jullienl/my-repo (slug only, NOT a URL) (required)
# GITHUB_TOKEN=change-me         # token with issues:write (secret; prefer GITHUB_TOKEN_FILE)
# GITHUB_API_URL=https://api.github.com   # override for GitHub Enterprise Server (.../api/v3)
# GITHUB_LABELS=ops,com          # optional extra labels added to new issues

# --- Target: Slack (slack) ------------------------------------------------
# Posts a formatted message to a Slack Incoming Webhook. Post-only: a raise and a
# clear are two messages (clear shows a green "Resolved").

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx   # secret; prefer SLACK_WEBHOOK_URL_FILE
# SLACK_USERNAME=HPE COM         # optional display name override

# --- Target: Microsoft Teams (teams) --------------------------------------
# Posts an Adaptive Card via a Teams Workflows / Power Automate webhook. Post-only.

# TEAMS_WEBHOOK_URL=https://prod-00.westeurope.logic.azure.com/workflows/xxx   # secret; prefer TEAMS_WEBHOOK_URL_FILE

# --- Target: Jira Service Management (jira) --------------------------------
# Creates an issue on a raise, closes the matching one on a clear (correlated by
# a com-<key> label + a named workflow transition). Jira Cloud REST API v3.

# JIRA_URL=https://acme.atlassian.net
# JIRA_EMAIL=integrations@acme.com        # Atlassian account (Basic auth user)
# JIRA_API_TOKEN=change-me                # API token (secret; prefer JIRA_API_TOKEN_FILE)
# JIRA_PROJECT_KEY=OPS
# JIRA_ISSUE_TYPE=Incident                # issue type name (default Incident)
# JIRA_CLOSE_TRANSITION=Done              # transition used to close on a clear
# JIRA_LABELS=hpe-com                     # optional extra labels on new issues

# --- Target: PagerDuty (pagerduty) ----------------------------------------
# Triggers on a raise, resolves on a clear via Events API v2 (native dedup_key).

# PAGERDUTY_ROUTING_KEY=change-me         # Events API v2 integration key (secret)
# PAGERDUTY_API_URL=https://events.pagerduty.com/v2/enqueue   # EU: events.eu.pagerduty.com
# PAGERDUTY_SOURCE=HPE Compute Ops Management

# --- Target: Microsoft Sentinel (sentinel) --------------------------------
# Ingests into a Log Analytics workspace (Data Collector API, HMAC signed).
# Post-only; lands in table <SENTINEL_LOG_TYPE>_CL.

# SENTINEL_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# SENTINEL_SHARED_KEY=change-me           # workspace primary/secondary key (secret)
# SENTINEL_LOG_TYPE=HPECOMEvent

# --- Target: Datadog (datadog) --------------------------------------------
# Posts to the Events API; raise/clear grouped by aggregation_key. Post-only.

# DATADOG_API_KEY=change-me               # API key (secret; prefer DATADOG_API_KEY_FILE)
# DATADOG_SITE=datadoghq.com              # e.g. datadoghq.eu, us3.datadoghq.com
# DATADOG_TAGS=team:infra,source:hpe-com  # optional tags added to every event

# --- Target: Elasticsearch (elastic) --------------------------------------
# Indexes each event as a document. API key preferred, else HTTP basic. Post-only.

# ELASTIC_URL=https://es.example.com:9200
# ELASTIC_INDEX=hpe-com-events
# ELASTIC_API_KEY=change-me               # base64 API key (secret); or use basic below
# ELASTIC_USER=elastic                    # basic auth (only if no API key)
# ELASTIC_PASSWORD=change-me              # secret; prefer ELASTIC_PASSWORD_FILE
# ELASTIC_VERIFY_TLS=true

# --- Target: BMC Helix ITSM (bmc_helix) -----------------------------------
# Creates an incident on a raise, resolves the matching one on a clear
# (correlated by a [COM:<key>] marker in the detailed description). AR System /
# Innovation Suite REST API, JWT auth.

# BMC_HELIX_URL=https://acme-restapi.onbmc.com
# BMC_HELIX_USER=svc-hpe-com              # AR System user (JWT login)
# BMC_HELIX_PASSWORD=change-me            # secret; prefer BMC_HELIX_PASSWORD_FILE
# BMC_HELIX_FIRST_NAME=HPE                # requester first name on new incidents
# BMC_HELIX_LAST_NAME=COM                 # requester last name on new incidents
# BMC_HELIX_SERVICE_TYPE=Infrastructure Event
# BMC_HELIX_REPORTED_SOURCE=Systems Management
# BMC_HELIX_ASSIGNED_GROUP=Server Team    # optional routing group
# BMC_HELIX_STATUS_RESOLVED=Resolved      # status used to close on a clear

# --- Target: Dynatrace (dynatrace) ----------------------------------------
# Posts to the Events API v2 (events.ingest). Post-only: raise=ERROR_EVENT,
# clear=CUSTOM_INFO, threaded by the com.correlation_key property.

# DYNATRACE_URL=https://abc12345.live.dynatrace.com   # SaaS, or Managed .../e/<env-id>
# DYNATRACE_API_TOKEN=change-me           # token with events.ingest (secret)
# DYNATRACE_ENTITY_SELECTOR=type("HOST")  # optional entity to attach events to
# DYNATRACE_PROPERTIES=team=infra,source=hpe-com   # optional extra properties

# --- Target: Grafana Cloud Logs (grafana) ---------------------------------
# Ships each event as a Loki log line (Grafana Cloud Logs). Post-only; search in
# Explore / build Grafana alert rules on the stream. Basic auth (user id + token).

# GRAFANA_LOKI_URL=https://logs-prod-012.grafana.net
# GRAFANA_LOKI_USER=123456                # Grafana Cloud Logs user / instance id
# GRAFANA_API_TOKEN=change-me             # access-policy token w/ logs:write (secret)
# GRAFANA_LABELS=env=prod,team=infra      # optional extra low-cardinality labels

# --- Target: generic webhook (webhook) ------------------------------------

# WEBHOOK_URL=https://example.com/inbound
# WEBHOOK_AUTH_HEADER=Authorization
# WEBHOOK_AUTH_VALUE=Bearer change-me
