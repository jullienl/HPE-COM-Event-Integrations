# COM cloud relay configuration
# Copy to .env and fill in real values. Never commit the real .env.

# --- Common ---------------------------------------------------------------

# Shared secret you set in the COM webhook "headers".
# Generate a long random value, e.g.: openssl rand -hex 32
COM_SHARED_SECRET=change-me-long-random-value

# Name of the custom header COM attaches the shared secret to.
# HTTP header names are case-insensitive; the app compares case-insensitively.
SHARED_SECRET_HEADER=x-shim-secret

# Max accepted request body size in bytes (protects the public endpoint).
# Default 262144 (256 KB).
MAX_BODY_BYTES=262144

# Which queue backend to use: servicebus | sqs
QUEUE_BACKEND=servicebus

# --- Azure Service Bus backend (QUEUE_BACKEND=servicebus) -----------------

# Send-scoped connection string (source from Key Vault in production).
SERVICE_BUS_CONNECTION=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=send;SharedAccessKey=change-me
QUEUE_NAME=com-events

# --- AWS SQS backend (QUEUE_BACKEND=sqs) ----------------------------------

# Full queue URL and region. Prefer an IAM task/execution role over static keys.
# SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/com-events
# AWS_REGION=eu-west-1
