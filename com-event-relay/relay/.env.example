# COM cloud relay configuration
# Copy to .env and fill in real values. Never commit the real .env.
#
# SECRETS — file vs env. Sensitive values (COM_SHARED_SECRET, SERVICE_BUS_CONNECTION)
# can be provided EITHER as the plain variable shown here (fine for local dev) OR
# — preferred in production — as a file, by setting "<NAME>_FILE" to a path the app
# reads at startup (the file wins if both are set). This keeps secrets out of .env
# and the process environment. Any vault that projects a secret onto disk works
# (Key Vault / Secrets Manager via the Secrets Store CSI driver, Docker secrets at
# /run/secrets/<name>, systemd LoadCredential). Example:
#   COM_SHARED_SECRET_FILE=/mnt/secrets-store/com-shared-secret
# See com-event-relay/README.md "Secrets management" for step-by-step wiring.

# --- Common ---------------------------------------------------------------

# Shared secret you set in the COM webhook "headers".
# Generate a long random value, e.g.: openssl rand -hex 32
# In production prefer COM_SHARED_SECRET_FILE=/path/to/secret.
COM_SHARED_SECRET=change-me-long-random-value

# Name of the custom header COM attaches the shared secret to.
# HTTP header names are case-insensitive; the app compares case-insensitively.
SHARED_SECRET_HEADER=x-shim-secret

# Max accepted request body size in bytes (protects the public endpoint).
# Default 262144 (256 KB).
MAX_BODY_BYTES=262144

# Verbosity of the Azure SDK (azure.servicebus) logger. The AMQP stack logs every
# idle connection/session/link teardown + reconnect at INFO, which floods the
# relay logs; default WARNING quiets it. Set to INFO/DEBUG only to diagnose
# Service Bus connectivity.
AZURE_SDK_LOG_LEVEL=WARNING

# Which queue backend to use: servicebus | sqs
QUEUE_BACKEND=servicebus

# --- Azure Service Bus backend (QUEUE_BACKEND=servicebus) -----------------

# Send-scoped connection string (source from Key Vault in production).
# In production prefer SERVICE_BUS_CONNECTION_FILE=/mnt/secrets-store/sb-connection.
SERVICE_BUS_CONNECTION=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=send;SharedAccessKey=change-me
QUEUE_NAME=com-events

# --- AWS SQS backend (QUEUE_BACKEND=sqs) ----------------------------------

# Full queue URL and region. Prefer an IAM task/execution role over static keys.
# SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/com-events
# AWS_REGION=eu-west-1
